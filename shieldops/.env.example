# ── ShieldOps Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here
JWT_REFRESH_SECRET=CHANGE_ME_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXP=7d

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=CHANGE_ME_strong_password

# ── Internal service auth ─────────────────────────────────────────────────────
INTERNAL_API_KEY=CHANGE_ME_internal_service_key

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# ── SonarQube (CI only) ───────────────────────────────────────────────────────
# SONAR_TOKEN=
# SONAR_HOST_URL=
