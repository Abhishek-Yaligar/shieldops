{
  "title": "ShieldOps Security Dashboard",
  "uid": "shieldops-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Service Health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value","options": {"0": {"text": "DOWN","color": "red"}, "1": {"text": "UP","color": "green"}}}],
          "thresholds": {"steps": [{"color": "red","value": 0}, {"color": "green","value": 1}]}
        }
      }
    },
    {
      "id": 2,
      "title": "Anomaly Detection Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 10, "h": 8 },
      "targets": [{
        "expr": "rate(ai_module_requests_total[5m])",
        "legendFormat": "{{result}}"
      }]
    },
    {
      "id": 3,
      "title": "Last Anomaly Score",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "expr": "ai_module_last_anomaly_score" }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              {"color": "green","value": 0},
              {"color": "yellow","value": 0.35},
              {"color": "red","value": 0.7}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(http_requests_total[5m])",
        "legendFormat": "{{job}} - {{method}} {{status}}"
      }]
    },
    {
      "id": 5,
      "title": "Response Time P95 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_request_duration_ms_bucket[5m]))",
        "legendFormat": "p95 {{job}}"
      }]
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
